# Copie para .env.local (NUNCA versionar). Em produção, use o Secret Manager.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://app_implantacao:TROCAR@localhost:5432/implantacao
# DATABASE_SSL=require            # produção
# Chaves de criptografia por campo: gere com `openssl rand -base64 32`. A última é a atual.
FIELD_ENCRYPTION_KEYS=v1=GERAR_COM_openssl_rand_-base64_32
# Login Google (OAuth 2.0 Client ID do tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=biscoite.com.br
# Primeiros administradores (só usados pelo `npm run migrate`)
INITIAL_ADMINS=
SESSION_MAX_HOURS=8
SESSION_IDLE_MINUTES=30
# Local, sem Google: só funciona com NODE_ENV != production e APP_URL em localhost
DEV_LOGIN_ENABLED=false
# Leitura das planilhas: no Cloud Run, deixe vazio (usa a identidade do serviço).
# Localmente: caminho para o JSON da conta de serviço, FORA da pasta do projeto.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repo/sa.json
